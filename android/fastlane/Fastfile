default_platform(:android)

platform :android do
  desc "Submit a new build to Google Play (defaults to beta track)"
  lane :publish do |options|
    aab_path = options[:aab_path]
    version_code = options[:version_code]
    track = options[:track] || "beta"

    changelog = "New release update"
    if options[:changelog_path] && File.exist?(options[:changelog_path])
      changelog = File.read(options[:changelog_path]).strip
    elsif options[:changelog]
      changelog = options[:changelog]
    end

    UI.message("Publishing to Google Play track '#{track}'...")
    UI.message("AAB path: #{aab_path}")

    if version_code
      changelog_dir = "metadata/android/en-US/changelogs"
      sh("mkdir", "-p", changelog_dir)
      # Google Play enforces a 500-character limit on release notes.
      File.write("#{changelog_dir}/#{version_code}.txt", changelog[0...500])
      UI.message("Saved changelog to #{changelog_dir}/#{version_code}.txt")
    end

    supply(
      package_name: "dev.oazzies.mangabaka_app",
      track: track,
      aab: aab_path,
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end

  desc "Submit a new build to Google Play Public Testing (beta)"
  lane :publish_to_testing do |options|
    publish(options.merge(track: "beta"))
  end

  desc "Submit a new build to Google Play Production"
  lane :publish_to_production do |options|
    publish(options.merge(track: "production"))
  end
end
